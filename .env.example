# Copy this file to .env and fill in real values. .env is gitignored and never committed.

# Required to use the bird-sound guide feature. Register a free key at
# https://xeno-canto.org/account
XENO_CANTO_API_KEY=

# Required to actually deliver the registration verification email. Without these,
# SMTP send fails and the raw link is only visible in the server logs (still fine
# for local dev - see EmailServiceImpl). Any SMTP provider works (Gmail app password,
# Mailtrap/Ethereal for testing, SendGrid/Mailgun/SES's SMTP relay, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@wingmark.app

# Everything below has a working default for local development (a local
# MongoDB on localhost:27017, a dev-only JWT secret) - only override if you
# need something different.

# JWT_SECRET=change-this-development-only-secret-key-please-override-me-1234567890
# JWT_ACCESS_EXPIRATION_MS=900000
# JWT_REFRESH_EXPIRATION_MS=2592000000

# Point this at MongoDB Atlas (or any other instance) once you have one, e.g.:
# DB_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster-host>/wingmark?retryWrites=true&w=majority
# DB_CONNECTION_STRING=mongodb://localhost:27017/wingmark

# SERVER_PORT=8080
# UPLOAD_DIR=uploads

# This backend's own public URL - used to build the verification-email link
# (GET {APP_BASE_URL}/api/auth/verify-email?token=...). Set this to the real
# deployed URL in production, e.g. https://wingmark-backend.onrender.com
# APP_BASE_URL=http://localhost:8080
