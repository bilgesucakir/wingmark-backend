# Copy this file to .env and fill in real values. .env is gitignored and never committed.

# Required to use the bird-sound guide feature. Register a free key at
# https://xeno-canto.org/account
XENO_CANTO_API_KEY=

# Everything below has a working default for local development (a local
# MongoDB on localhost:27017, a dev-only JWT secret) - only override if you
# need something different.

# JWT_SECRET=change-this-development-only-secret-key-please-override-me-1234567890
# JWT_ACCESS_EXPIRATION_MS=900000
# JWT_REFRESH_EXPIRATION_MS=2592000000

# Point this at MongoDB Atlas (or any other instance) once you have one, e.g.:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/wingmark?retryWrites=true&w=majority
# MONGODB_URI=mongodb://localhost:27017/wingmark

# SERVER_PORT=8080
# UPLOAD_DIR=uploads
